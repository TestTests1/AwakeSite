{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://stalcraftclans.cc",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "ETag", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
